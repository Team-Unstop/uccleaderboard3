<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Leaderboard 3</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');
  :root{
    --bg: #0A0C10;
    --panel: #12151C;
    --panel-2: #171B24;
    --line: #232834;
    --text: #E9ECF1;
    --text-dim: #8A93A3;
    --gold: #F2B705;
    --silver: #C7CDD6;
    --bronze: #D98A3D;
    --accent: #2DD4BF;
    --accent-dim: rgba(45,212,191,0.16);
    --danger: #E5484D;
    --font-display: 'Oswald', 'Arial Narrow', sans-serif;
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: 'JetBrains Mono', 'Courier New', monospace;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{height:100%;}
  body{
    background: var(--bg);
    background-image:
      radial-gradient(circle at 12% 0%, rgba(45,212,191,0.07), transparent 40%),
      radial-gradient(circle at 88% 100%, rgba(242,183,5,0.05), transparent 45%);
    color: var(--text);
    font-family: var(--font-body);
    min-height: 100vh;
    padding: 32px 16px 60px;
    -webkit-font-smoothing: antialiased;
  }
  .wrap{ max-width: 820px; margin: 0 auto; }

  /* ---------- Header ---------- */
  header{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .eyebrow{
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    display:flex;
    align-items:center;
    gap:8px;
    margin-bottom: 8px;
  }
  .dot{
    width:6px; height:6px; border-radius:50%;
    background: var(--accent);
    animation: pulse 2s infinite;
    flex-shrink:0;
  }
  .dot.stale{ background: var(--danger); animation:none; }
  @keyframes pulse{
    0%{ box-shadow: 0 0 0 0 rgba(45,212,191,0.5); }
    70%{ box-shadow: 0 0 0 8px rgba(45,212,191,0); }
    100%{ box-shadow: 0 0 0 0 rgba(45,212,191,0); }
  }
  h1{
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 5vw, 44px);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .meta{
    text-align:right;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    line-height:1.7;
    white-space: nowrap;
  }
  .meta b{ color: var(--text); font-weight:700; }

  /* ---------- Controls ---------- */
  .controls{
    display:flex;
    gap:10px;
    margin-bottom: 20px;
  }
  .search-box{ flex:1; position:relative; }
  .search-box svg{
    position:absolute; left:15px; top:50%; transform:translateY(-50%);
    width:16px; height:16px; stroke:var(--text-dim);
    pointer-events:none;
  }
  input[type="text"]{
    width:100%;
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 15px;
    padding: 13px 16px 13px 42px;
    border-radius: 10px;
    outline:none;
    transition: border-color 0.15s, background 0.15s;
  }
  input[type="text"]::placeholder{ color: var(--text-dim); }
  input[type="text"]:focus{ border-color: var(--accent); background: var(--panel-2); }

  .refresh-btn{
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing:0.04em;
    text-transform:uppercase;
    padding: 0 16px;
    border-radius: 10px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:8px;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink:0;
  }
  .refresh-btn:hover{ border-color: var(--accent); color: var(--accent); }
  .refresh-btn svg{ width:14px; height:14px; }
  .refresh-btn.spinning svg{ animation: spin 0.8s linear infinite; }
  @keyframes spin{ to{ transform: rotate(360deg); } }

  /* ---------- Match banner ---------- */
  .match-banner{
    display:none;
    background: var(--accent-dim);
    border: 1px solid rgba(45,212,191,0.35);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 11px 16px;
    border-radius: 10px;
    margin-bottom: 16px;
  }
  .match-banner.show{ display:block; }
  .match-banner b{ color: var(--text); font-family: var(--font-body); font-weight:700; }

  /* ---------- Board ---------- */
  .board{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }

  .row-head, .row{
    display:grid;
    grid-template-columns: 56px 1fr 120px 90px;
    column-gap: 16px;
    align-items:center;
    padding: 0 20px;
  }
  .row-head{
    padding-top: 13px;
    padding-bottom: 13px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    border-bottom: 1px solid var(--line);
  }
  .row-head .col-points{ text-align:right; }

  .row{
    padding-top: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    transition: background 0.15s;
  }
  .row:last-child{ border-bottom:none; }
  .row:hover{ background: var(--panel-2); }
  .row.highlight{ background: var(--accent-dim); }
  .row.highlight:hover{ background: var(--accent-dim); }
  .row.hidden{ display:none; }

  .rank{
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    color: var(--text-dim);
  }
  .rank.r1{ color: var(--gold); font-size:25px; }
  .rank.r2{ color: var(--silver); font-size:23px; }
  .rank.r3{ color: var(--bronze); font-size:23px; }

  .who{ min-width:0; }
  .name{
    font-weight: 700;
    font-size: 15px;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .college{
    font-size: 12.5px;
    color: var(--text-dim);
    margin-top: 3px;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }

  .bar-wrap{
    height: 5px;
    background: var(--line);
    border-radius: 3px;
    overflow:hidden;
  }
  .bar-fill{
    height:100%;
    border-radius:3px;
    background: linear-gradient(90deg, var(--accent), #7BF0E1);
  }
  .row .rank.r1 ~ .bar-wrap .bar-fill,
  .row:has(.rank.r1) .bar-fill{ background: linear-gradient(90deg, var(--gold), #FFDE7A); }
  .row:has(.rank.r2) .bar-fill{ background: linear-gradient(90deg, var(--silver), #EDEFF2); }
  .row:has(.rank.r3) .bar-fill{ background: linear-gradient(90deg, var(--bronze), #F0B784); }

  .points{
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 16px;
    text-align:right;
    color: var(--text);
    white-space:nowrap;
  }
  .points span{
    font-size: 10px;
    color: var(--text-dim);
    font-weight:500;
    margin-left:4px;
  }

  /* ---------- States ---------- */
  .state-box{
    padding: 56px 24px;
    text-align:center;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height:1.7;
  }
  .state-box.error{ color: var(--danger); }
  .no-results{
    padding: 40px 20px;
    text-align:center;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 13px;
    display:none;
  }
  .no-results.show{ display:block; }

  footer{
    text-align:center;
    margin-top: 26px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }

  @media (max-width: 600px){
    .row-head, .row{ grid-template-columns: 40px 1fr 76px; }
    .row-head .col-bar{ display:none; }
    .bar-wrap{ display:none; }
    .rank{ font-size:17px; }
    .points{ font-size:15px; }
    .meta{ text-align:left; white-space:normal; }
    header{ flex-direction:column; align-items:flex-start; }
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div>
      <div class="eyebrow"><span class="dot" id="statusDot"></span><span id="statusText">Live</span></div>
      <h1>Leaderboard 3</h1>
    </div>
    <div class="meta">
      <div><b id="totalCount">—</b> participants</div>
      <div>Updated <span id="lastUpdated">—</span></div>
    </div>
  </header>

  <div class="controls">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="searchInput" placeholder="Search your name or college…" autocomplete="off">
    </div>
    <button class="refresh-btn" id="refreshBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
      Refresh
    </button>
  </div>

  <div class="match-banner" id="matchBanner"></div>

  <div class="board" id="board">
    <div class="state-box" id="stateBox">Loading leaderboard…</div>
  </div>
  <div class="no-results" id="noResults">No one matches that search.</div>

  <footer>Auto-refreshes every 20s · Live data</footer>
</div>

<script>
const SHEET_ID = "1Do1emzQ33Mshun3rT1W_4K0IHCYDGs1x2MBMj5kGvYE";
const SHEET_GID = "0";
const REFRESH_MS = 20000;

let allRows = [];

const boardEl = document.getElementById('board');
const noResultsEl = document.getElementById('noResults');
const searchInput = document.getElementById('searchInput');
const lastUpdatedEl = document.getElementById('lastUpdated');
const totalCountEl = document.getElementById('totalCount');
const statusDot = document.getElementById('statusDot');
const statusText = document.getElementById('statusText');
const refreshBtn = document.getElementById('refreshBtn');
const matchBanner = document.getElementById('matchBanner');

function fetchSheetJSONP(){
  return new Promise((resolve, reject) => {
    const callbackName = '__gvizCB_' + Math.random().toString(36).slice(2);
    const timer = setTimeout(() => {
      cleanup();
      reject(new Error(
        'Timed out waiting for Google Sheets. Make sure it\'s shared: Share → General access → "Anyone with the link" → Viewer.'
      ));
    }, 12000);

    function cleanup(){
      clearTimeout(timer);
      delete window[callbackName];
      if(script.parentNode) script.parentNode.removeChild(script);
    }

    window[callbackName] = function(json){
      cleanup();
      resolve(json);
    };

    const url = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq`
      + `?tqx=out:json;responseHandler:${callbackName}`
      + `&gid=${SHEET_GID}&headers=1`
      + `&_=${Date.now()}`;

    const script = document.createElement('script');
    script.src = url;
    script.onerror = () => {
      cleanup();
      reject(new Error('Could not load the sheet. Confirm the sheet ID and sharing settings.'));
    };
    document.body.appendChild(script);
  });
}

function cellText(cell){
  if(!cell || cell.v === null || cell.v === undefined) return '';
  return cell.v.toString().trim();
}

function cellNumber(cell){
  if(!cell || cell.v === null || cell.v === undefined) return 0;
  const n = typeof cell.v === 'number' ? cell.v : parseFloat(cell.v);
  return isNaN(n) ? 0 : n;
}

function computeRanks(data){
  const sorted = [...data].sort((a,b) => b.points - a.points);
  const maxPoints = sorted.length ? sorted[0].points : 1;
  let rank = 0, prevPoints = null;
  return sorted.map((row) => {
    if(row.points !== prevPoints){
      rank++;
      prevPoints = row.points;
    }
    return {
      ...row,
      rank,
      pct: maxPoints > 0 ? Math.max(4, (row.points / maxPoints) * 100) : 0
    };
  });
}

function medalClass(rank){
  if(rank === 1) return 'r1';
  if(rank === 2) return 'r2';
  if(rank === 3) return 'r3';
  return '';
}

function escapeHtml(str){
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

function renderTable(rows){
  if(!rows.length){
    boardEl.innerHTML = `<div class="state-box">No data found yet.</div>`;
    return;
  }
  const head = `
    <div class="row-head">
      <span>Rank</span>
      <span>Participant</span>
      <span class="col-bar"></span>
      <span class="col-points">Points</span>
    </div>`;
  const body = rows.map(r => `
    <div class="row" data-name="${r.name.toLowerCase()}" data-college="${r.college.toLowerCase()}">
      <div class="rank ${medalClass(r.rank)}">${r.rank}</div>
      <div class="who">
        <div class="name">${escapeHtml(r.name)}</div>
        <div class="college">${escapeHtml(r.college)}</div>
      </div>
      <div class="bar-wrap"><div class="bar-fill" style="width:${r.pct}%"></div></div>
      <div class="points">${r.points}<span>PTS</span></div>
    </div>
  `).join('');
  boardEl.innerHTML = head + body;
}

function applySearch(){
  const q = searchInput.value.trim().toLowerCase();
  const rows = boardEl.querySelectorAll('.row');
  let visibleCount = 0;
  let firstMatch = null;

  rows.forEach(row => {
    const matches = !q || row.dataset.name.includes(q) || row.dataset.college.includes(q);
    row.classList.toggle('hidden', !matches);
    row.classList.toggle('highlight', !!q && matches);
    if(matches){
      visibleCount++;
      if(!firstMatch) firstMatch = row;
    }
  });

  noResultsEl.classList.toggle('show', q.length > 0 && visibleCount === 0);

  if(q && firstMatch){
    const rank = firstMatch.querySelector('.rank').textContent;
    const name = firstMatch.querySelector('.name').textContent;
    matchBanner.innerHTML = visibleCount === 1
      ? `Rank <b>#${rank}</b> — <b>${escapeHtml(name)}</b>`
      : `${visibleCount} matches found — top match: <b>#${rank} ${escapeHtml(name)}</b>`;
    matchBanner.classList.add('show');
    firstMatch.scrollIntoView({ behavior: 'smooth', block: 'center' });
  } else {
    matchBanner.classList.remove('show');
  }
}

function setStatus(ok){
  statusDot.classList.toggle('stale', !ok);
  statusText.textContent = ok ? 'Live' : 'Connection issue';
}

async function loadData(isManual){
  if(isManual) refreshBtn.classList.add('spinning');
  try{
    const json = await fetchSheetJSONP();

    if(json.status === 'error'){
      const reason = (json.errors && json.errors[0] && json.errors[0].detailed_message) || 'Unknown error';
      throw new Error(`Google Sheets error: ${reason}. Check the sheet ID and gid are correct.`);
    }

    const table = json.table;
    if(!table || !table.cols || !table.rows || !table.rows.length){
      boardEl.innerHTML = `<div class="state-box">This sheet tab looks empty.</div>`;
      setStatus(true);
      return;
    }

    const labels = table.cols.map(c => (c.label || c.id || '').toString().trim().toLowerCase());
    const findCol = (candidates) => {
      for(const c of candidates){
        const idx = labels.findIndex(l => l === c);
        if(idx !== -1) return idx;
      }
      for(const c of candidates){
        const idx = labels.findIndex(l => l.includes(c));
        if(idx !== -1) return idx;
      }
      return -1;
    };

    const nameIdx = findCol(['name']);
    const collegeIdx = findCol(['college']);
    const pointsIdx = findCol(['points', 'point', 'score']);

    if(nameIdx === -1 || collegeIdx === -1 || pointsIdx === -1){
      throw new Error(`Couldn't find Name / College / Points columns in the header row.`);
    }

    const cleaned = table.rows
      .map(row => ({
        name: cellText(row.c[nameIdx]),
        college: cellText(row.c[collegeIdx]),
        points: cellNumber(row.c[pointsIdx])
      }))
      .filter(r => r.name !== '');

    allRows = computeRanks(cleaned);
    renderTable(allRows);
    applySearch();

    totalCountEl.textContent = allRows.length;
    lastUpdatedEl.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    setStatus(true);

  } catch(err){
    console.error(err);
    setStatus(false);
    if(!allRows.length){
      boardEl.innerHTML = `<div class="state-box error">Couldn't load the leaderboard.<br><br>${escapeHtml(err.message)}</div>`;
    }
  } finally {
    if(isManual) setTimeout(() => refreshBtn.classList.remove('spinning'), 400);
  }
}

searchInput.addEventListener('input', applySearch);
refreshBtn.addEventListener('click', () => loadData(true));

loadData(false);
setInterval(() => loadData(false), REFRESH_MS);
</script>
</body>
</html>
